---
import Truck from './Truck.astro';
---
<div class="ba" data-ba style="--pos:50%">
  <div class="ba-layer ba-dirty"><Truck dirty /></div>
  <div class="ba-layer ba-clean"><Truck /></div>
  <span class="ba-tag ba-tag-l">Después</span>
  <span class="ba-tag ba-tag-r">Antes</span>
  <div class="ba-handle" aria-hidden="true"><span><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 7-5 5 5 5M15 7l5 5-5 5"/></svg></span></div>
  <input class="ba-range" type="range" min="2" max="98" value="50" aria-label="Deslizar para comparar antes y después de la limpieza" />
</div>
